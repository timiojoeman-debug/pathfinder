# OpenAI
OPENAI_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
JWT_SECRET=

# Job APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
JSEARCH_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Logging
LOG_LEVEL=info

# Rate limiting (optional) — set to move rate limiting to a shared store for
# multi-instance production. Without these the limiter runs in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-user daily AI request quota (cost protection). Default 60.
AI_DAILY_QUOTA=60

# Per-IP daily budget for logged-out visitors on guest-safe routes (job search).
# Keeps the try-before-signup experience from running up the Adzuna quota. Default 10.
ANON_AI_DAILY_QUOTA=10

# Email (transactional) — set to send real verification/reset emails via Resend.
# Without a key, emails (and their links) are logged to the server for dev.
RESEND_API_KEY=
EMAIL_FROM="PathFinder <onboarding@resend.dev>"
